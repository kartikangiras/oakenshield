# Copy to .env (or export) to run the server against a real Flagsmith project.
# Leave everything unset to run on demo data.

# demo | live (default: live when Flagsmith settings are present, else demo)
OAKENSHIELD_MODE=live
# Flagsmith organisation API key and the environment where experiments run
FLAGSMITH_API_KEY=
GUARD_FLAGSMITH_ENVIRONMENT=
# GUARD_FLAGSMITH_PROJECT=
# FLAGSMITH_API_URL=https://api.flagsmith.com

# A checkout to scan for code references to each experiment
# OAKENSHIELD_REPO_PATH=/path/to/your/app

# Token CI must send when posting reports to /api/reports
# OAKENSHIELD_TOKEN=

# PORT=8787
# HOST=127.0.0.1

# Secret set on the Flagsmith webhook (Organisation settings → Webhooks)
# OAKENSHIELD_WEBHOOK_SECRET=
# Lets webhook re-checks update pull request comments and commit statuses
# GITHUB_TOKEN=

# The dashboard's own A/B test (docs/experiment.md). Client-side values: the environment key is public.
# DASHBOARD_FLAGSMITH_ENVIRONMENT=
# Self-hosted Flagsmith only:
# DASHBOARD_FLAGSMITH_API_URL=https://flagsmith.example.com/api/v1/
# DASHBOARD_FLAGSMITH_EVENTS_URL=https://flagsmith.example.com/api/
